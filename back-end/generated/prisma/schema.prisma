generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  clothes   Cloth[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cloth {
  id        String   @id @default(cuid())
  name      String
  type      String // or enum, e.g., 'Shirt', 'Pants'
  color     String?
  imageUrl  String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
