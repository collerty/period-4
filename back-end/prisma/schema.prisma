generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  clothes   Cloth[]
  outfits   Outfit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cloth {
  id        String        @id @default(cuid())
  name      String
  type      String // could be an enum
  color     String?
  imageUrl  String?
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  outfits   OutfitCloth[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Outfit {
  id          String        @id @default(cuid())
  name        String
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  description String?
  imageUrl    String? // Optional: generated outfit preview
  clothes     OutfitCloth[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Join table for many-to-many Outfit <-> Cloth
model OutfitCloth {
  id       String @id @default(cuid())
  outfit   Outfit @relation(fields: [outfitId], references: [id])
  outfitId String
  cloth    Cloth  @relation(fields: [clothId], references: [id])
  clothId  String
}
